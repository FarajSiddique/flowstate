{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@flowstate/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AI_PROVIDER",
        "AI_GATEWAY_API_KEY",
        "FLOWSTATE_INTENT_MODEL",
        "FLOWSTATE_INTENT_TIMEOUT_MS",
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*", "SUPABASE_*", "CI"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
