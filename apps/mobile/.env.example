# Browser / iOS simulator. Android emulator: http://10.0.2.2:3000
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# EXPO_PUBLIC_* values are embedded in the app. Never put secrets here.

# Supabase (Settings → API Keys). Locally use nexui-dev. Publishable key only, never the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud OAuth clients. The web client ID is the webClientId used for ID tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID (com.googleusercontent.apps.…), used by the google-signin config plugin.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
