# Supabase (Settings → API Keys). Locally use nexui-dev. Not needed for the health endpoint.
SUPABASE_URL=
# sb_publishable_…
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… — server only; used for account deletion. Never expose to the mobile app.
SUPABASE_SECRET_KEY=

# Server credentials must remain in this API workspace and have no PUBLIC prefix.
AI_PROVIDER=mock
AI_GATEWAY_API_KEY=
# Jev's Gateway model ID; used only when AI_PROVIDER=jev.
NEXUI_INTENT_MODEL=typesafe-ai/jev
# 1–4500 ms; keep below the mobile client's 5000 ms timeout.
NEXUI_INTENT_TIMEOUT_MS=3500
